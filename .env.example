# Copy this file to ".env" and fill it in. Never commit .env or share the key.
RIOT_API_KEY=RGAPI-paste-your-key-here
# Riot IDs to track, comma separated, written as GameName#TAG
RIOT_IDS=Hyro4209#NA1
# Routing region for match data: americas, europe, asia or sea (NA uses americas)
RIOT_ROUTING=americas
# How many recent matches to pull per player on each run
MATCH_COUNT=50
